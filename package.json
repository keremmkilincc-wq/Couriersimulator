  },
  "devDependencies": {
    "electron": "^30.0.0",
    "@capacitor/cli": "^6.1.0"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.0",
    "@capacitor/android": "^6.1.0"
  }
}
